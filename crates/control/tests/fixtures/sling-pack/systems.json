  "procedures": {
    "version": 1,
    "source": "Sling 2 Pilot Operating Handbook DC-POH-002-X-B-2.8 Revision 2.8: sections 4.5.1, 4.5.2, 4.5.3, 4.6, 4.7.1, 4.15, 4.16 and supplement 04/2012 (Rotax 912 iS) sections 9.4.12 and 9.4.13. Rotax 912 iS operator's manual not consulted (not obtainable); items it governs are marked.",
    "checklists": [
      {
        "id": "before_start",
        "title": "Before starting engine",
        "phase": "before_start",
        "poh_ref": "POH 4.5.1",
        "items": [
          {
            "id": "preflight",
            "text": "Pre-flight inspection",
            "response": "completed",
            "poh_ref": "POH 4.5.1 item 1"
          },
          {
            "id": "emergency_equipment",
            "text": "Emergency equipment",
            "response": "on board",
            "poh_ref": "POH 4.5.1 item 2"
          },
          {
            "id": "passenger",
            "text": "Passenger",
            "response": "briefed",
            "poh_ref": "POH 4.5.1 item 3"
          },
          {
            "id": "seats",
            "text": "Seats, seatbelt and harnesses",
            "response": "adjust and secure",
            "poh_ref": "POH 4.5.1 item 4"
          },
          {
            "id": "brakes",
            "text": "Brakes",
            "response": "on",
            "poh_ref": "POH 4.5.1 item 5",
            "verify": {
              "kind": "brake",
              "set": true
            }
          }
        ]
      },
      {
        "id": "engine_start",
        "title": "Engine start (Rotax 912 iS)",
        "phase": "engine_start",
        "poh_ref": "POH 4.5.2; supplement 9.4.12",
        "items": [
          {
            "id": "master",
            "text": "Master switch",
            "response": "on",
            "poh_ref": "POH 9.4.12 item 1",
            "verify": {
              "kind": "master",
              "on": true
            },
            "note": "Observe the temperature limits for engine start (POH 2.14)."
          },
          {
            "id": "efis_backup",
            "text": "EFIS back-up battery",
            "response": "on, verify EFIS on and back-up battery voltage",
            "poh_ref": "POH 9.4.12 item 2",
            "verify": {
              "kind": "backup_battery",
              "circuit": "efis",
              "on": true,
              "min_voltage": 11.5
            },
            "control": "efis_backup_switch",
            "unverified": "The back-up battery voltage limit is an original estimate; the POH asks only that the voltage be verified."
          },
          {
            "id": "lane_a",
            "text": "Ignition Lane A",
            "response": "on",
            "poh_ref": "POH 9.4.12 item 5",
            "verify": {
              "kind": "lane",
              "lane": "a",
              "on": true
            },
            "control": "lane_a"
          },
          {
            "id": "lane_b",
            "text": "Ignition Lane B",
            "response": "on",
            "poh_ref": "POH 9.4.12 item 5",
            "verify": {
              "kind": "lane",
              "lane": "b",
              "on": true
            },
            "control": "lane_b"
          },
          {
            "id": "ems_backup",
            "text": "EMS battery back-up switch",
            "response": "on",
            "poh_ref": "POH 9.4.12 item 6",
            "verify": {
              "kind": "backup_battery",
              "circuit": "ems",
              "on": true,
              "min_voltage": 11.5
            },
            "control": "ems_backup",
            "unverified": "The back-up battery voltage limit is an original estimate; the POH asks only that the voltage be verified."
          },
          {
            "id": "lane_lights",
            "text": "Lane A and Lane B warning lights",
            "response": "on for about 5 s, then out",
            "poh_ref": "POH 9.4.12 item 6 (warning)",
            "note": "Flashing, or not lighting, is a deficiency: do not take the engine into operation before it is rectified."
          },
          {
            "id": "fuel_selector",
            "text": "Fuel selector",
            "response": "select emptiest tank (if not empty)",
            "poh_ref": "POH 9.4.12 item 7",
            "verify": {
              "kind": "fuel_selector",
              "positions": [
                "left",
                "right"
              ]
            },
            "control": "fuel_selector"
          },
          {
            "id": "throttle_idle",
            "text": "Throttle",
            "response": "set to idle position",
            "poh_ref": "POH 9.4.12 item 8",
            "verify": {
              "kind": "throttle",
              "max": 0.05
            },
            "note": "Start with the throttle at idle or at most 5% open, to avoid shock loading."
          },
          {
            "id": "pump_1",
            "text": "Fuel pump 1",
            "response": "on",
            "poh_ref": "POH 9.4.12 item 9",
            "verify": {
              "kind": "pump",
              "pump": "one",
              "on": true
            },
            "control": "pump1"
          },
          {
            "id": "pump_2",
            "text": "Fuel pump 2",
            "response": "on",
            "poh_ref": "POH 9.4.12 item 9",
            "verify": {
              "kind": "pump",
              "pump": "two",
              "on": true
            },
            "control": "pump2"
          },
          {
            "id": "prop_area",
            "text": "Propeller area",
            "response": "clear of people and obstructions",
            "poh_ref": "POH 9.4.12 item 10"
          },
          {
            "id": "starter",
            "text": "Starter",
            "response": "activate (maximum 10 seconds)",
            "poh_ref": "POH 9.4.12 item 11; 4.5.2 caution",
            "verify": {
              "kind": "engine_running",
              "running": true
            },
            "control": "ignition",
            "timer": {
              "label": "Starter",
              "kind": "max",
              "seconds": 10,
              "start_when": {
                "kind": "starter",
                "engaged": true
              }
            },
            "note": "After a start attempt wait at least 2 minutes for the starter to cool."
          },
          {
            "id": "smooth_running",
            "text": "Throttle",
            "response": "adjust for smooth running (approximately 2,000 rpm)",
            "poh_ref": "POH 9.4.12 item 12",
            "verify": {
              "kind": "rpm",
              "min": 1700,
              "max": 2300
            }
          },
          {
            "id": "oil_pressure",
            "text": "Oil pressure",
            "response": "increase within 10 seconds",
            "poh_ref": "POH 9.4.12 item 13",
            "verify": {
              "kind": "oil_pressure",
              "min_bar": 3.0
            },
            "control": "left_display",
            "timer": {
              "label": "Oil pressure",
              "kind": "within",
              "seconds": 10,
              "start_when": {
                "kind": "engine_running",
                "running": true
              }
            },
            "note": "Increase rpm only if oil pressure is steady above 3 bar (44 psi). With cold oil keep watching it: it can drop again."
          },
          {
            "id": "avionics",
            "text": "Avionics master switch",
            "response": "on",
            "poh_ref": "POH 4.5.2 item 15",
            "verify": {
              "kind": "avionics",
              "on": true
            },
            "control": "avionics_switch"
          }
        ],
        "limits": [
          {
            "id": "oil_before_rpm",
            "message": "Increase rpm only once oil pressure is steady above 3 bar.",
            "poh_ref": "POH 9.4.12 caution",
            "when": {
              "kind": "all",
              "of": [
                {
                  "kind": "engine_running",
                  "running": true
                },
                {
                  "kind": "rpm",
                  "min": 2600
                },
                {
                  "kind": "oil_pressure",
                  "max_bar": 3.0
                }
              ]
            }
          }
        ]
      },
      {
        "id": "warm_up",
        "title": "Engine warm-up",
        "phase": "warm_up",
        "poh_ref": "POH 4.5.3; supplement 9.4.12 items 14-17",
        "items": [
          {
            "id": "brakes",
            "text": "Wheel brakes or chocks",
            "response": "on",
            "poh_ref": "POH 4.5.3",
            "verify": {
              "kind": "brake",
              "set": true
            }
          },
          {
            "id": "warm_2000",
            "text": "Warm up at 2,000 rpm",
            "response": "approximately 2 minutes",
            "poh_ref": "POH 4.5.3; 4.5.2 item 16",
            "verify": {
              "kind": "rpm",
              "min": 1800,
              "max": 2200
            },
            "timer": {
              "label": "Warm-up at 2,000 rpm",
              "kind": "hold",
              "seconds": 120
            },
            "note": "Supplement 9.4.12 item 14 allows one minute for the 912 iS; the longer figure of 4.5.3 is used here."
          },
          {
            "id": "alt_b",
            "text": "Main bus voltage",
            "response": "13.8 to 14.4 V (alternator B online)",
            "poh_ref": "POH 9.4.12 item 15",
            "verify": {
              "kind": "bus_voltage",
              "min_v": 13.8,
              "max_v": 14.4
            },
            "control": "left_display",
            "note": "The supplement raises rpm to about 3,000 until the voltage shows alternator B online."
          },
          {
            "id": "warm_2500",
            "text": "Engine speed",
            "response": "2,500 rpm",
            "poh_ref": "POH 4.5.3; 9.4.12 item 16",
            "verify": {
              "kind": "rpm",
              "min": 2300,
              "max": 2700
            }
          },
          {
            "id": "oil_temp",
            "text": "Oil temperature",
            "response": "50 C (122 F)",
            "poh_ref": "POH 4.5.3; 9.4.12 item 16",
            "verify": {
              "kind": "oil_temp",
              "min_c": 50
            },
            "control": "left_display"
          },
          {
            "id": "ems_off",
            "text": "EMS battery back-up switch",
            "response": "off",
            "poh_ref": "POH 9.4.12 item 17",
            "verify": {
              "kind": "backup_battery",
              "circuit": "ems",
              "on": false
            },
            "control": "ems_backup"
          },
          {
            "id": "instruments",
            "text": "Engine instrument readings",
            "response": "verify all",
            "poh_ref": "POH 9.4.12 after item 17"
          }
        ],
        "limits": [
          {
            "id": "rpm_before_warm",
            "message": "Hold the engine to 2,500 rpm or less until the oil is at 50 C.",
            "poh_ref": "POH 4.5.3",
            "when": {
              "kind": "all",
              "of": [
                {
                  "kind": "engine_running",
                  "running": true
                },
                {
                  "kind": "rpm",
                  "min": 3200
                },
                {
                  "kind": "oil_temp",
                  "max_c": 49.9
                }
              ]
            }
          }
        ]
      },
      {
        "id": "run_up",
        "title": "Run-up (engine check)",
        "phase": "run_up",
        "poh_ref": "POH 4.5.3; supplement 9.4.13",
        "items": [
          {
            "id": "brakes",
            "text": "Wheel brakes or chocks",
            "response": "on",
            "poh_ref": "POH 4.5.3",
            "verify": {
              "kind": "brake",
              "set": true
            }
          },
          {
            "id": "into_wind",
            "text": "Aircraft heading",
            "response": "upwind, not on loose terrain",
            "poh_ref": "POH 4.5.3 caution",
            "note": "The propeller can suck up grit that damages the blade leading edges."
          },
          {
            "id": "oil_warm",
            "text": "Oil temperature",
            "response": "50 C (122 F) or more",
            "poh_ref": "POH 4.5.3",
            "verify": {
              "kind": "oil_temp",
              "min_c": 50
            },
            "control": "left_display",
            "note": "Do not run up a cold engine. If the oil is below 50 C keep warming it at 2,500 rpm.",
            "stop_on_failure": true
          },
          {
