{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NycLidarSource",
  "description": "Lives at tileset.extras.flightcraft.nycLidar. Input leaves each contain one complete\nbuilding GLB in an explicit ECEF transform; no Socrata, TUM, or external footprint input.",
  "type": "object",
  "properties": {
    "receipts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NycLidarReceipt"
      }
    },
    "reconstructionBuildings": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "reconstructionLeavesAreBuildings": {
      "type": "boolean"
    },
    "selection": {
      "$ref": "#/$defs/FlyNycArea"
    },
    "usesExternalFootprints": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "required": [
    "selection",
    "reconstructionBuildings",
    "reconstructionLeavesAreBuildings",
    "usesExternalFootprints",
    "receipts"
  ],
  "$defs": {
    "FlyNycArea": {
      "description": "Geographic order is west, south, east, north, in degrees. Source cube order is\nxmin, ymin, zmin, xmax, ymax, zmax, in the EPT source frame; padding is not ground elevation.",
      "type": "object",
      "properties": {
        "area": {
          "type": "string"
        },
        "bounds": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 4,
          "minItems": 4
        },
        "buildingBudgetBytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "classification": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "ept": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "sourceCrs": {
          "type": "string"
        },
        "sourceCubeBounds": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 6,
          "minItems": 6
        },
        "sourcePoints": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "totalWebBudgetBytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "version": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "region",
        "area",
        "bounds",
        "buildingBudgetBytes",
        "totalWebBudgetBytes",
        "ept",
        "sourceCrs",
        "sourceCubeBounds",
        "sourcePoints",
        "classification"
      ]
    },
    "NycLidarReceipt": {
      "description": "Same URL/edition/date/byte-count/SHA-256 fields as acquisition receipts. No credentials.",
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "downloaded_at": {
          "type": "string"
        },
        "edition": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "url",
        "downloaded_at",
        "bytes",
        "sha256"
      ]
    }
  }
}
