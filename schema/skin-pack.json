{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkinPackManifest",
  "type": "object",
  "properties": {
    "assets": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/SkinAsset"
      },
      "maxItems": 16
    },
    "display_model": {
      "description": "The display model this skin dresses.",
      "$ref": "#/$defs/DisplayModel"
    },
    "display_name": {
      "type": "string"
    },
    "font": {
      "description": "Path of the chrome font among `assets`.",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "format_version": {
      "type": "integer",
      "format": "uint32",
      "maximum": 1,
      "minimum": 1
    },
    "id": {
      "type": "string"
    },
    "instruments": {
      "description": "Instrument-face palette and typography (tapes, boxes, colour meanings, type sizes).",
      "$ref": "#/$defs/InstrumentStyle",
      "default": {
        "palette": {
          "box_border": null,
          "box_fill": null,
          "box_text": null,
          "cyan": null,
          "green": null,
          "ground": null,
          "magenta": null,
          "red": null,
          "sky": null,
          "tape_fill": null,
          "tape_text": null,
          "white": null,
          "yellow": null
        },
        "typography": {
          "annunciation_text": null,
          "box_text": null,
          "data_bar_text": null,
          "tape_text": null
        }
      }
    },
    "kind": {
      "type": "string"
    },
    "labels": {
      "description": "Short functional labels printed on keys, by control. At most 8 characters each.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "licence": {
      "description": "SPDX licence identifier of the skin pack.",
      "type": "string"
    },
    "palette": {
      "$ref": "#/$defs/SkinPalette",
      "default": {
        "bezel": null,
        "bezel_trim": null,
        "key_face": null,
        "key_text": null,
        "knob": null,
        "knob_mark": null,
        "screen_surround": null
      }
    },
    "version": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "kind",
    "format_version",
    "id",
    "version",
    "display_name",
    "licence",
    "display_model"
  ],
  "$defs": {
    "DisplayModel": {
      "description": "A display class the engine knows how to draw and operate.",
      "oneOf": [
        {
          "description": "10.6-inch landscape touch EFIS with a bottom row of physical controls.",
          "type": "string",
          "const": "landscape_touch_efis"
        }
      ]
    },
    "InstrumentPalette": {
      "description": "Colours for the instrument faces (tapes, boxes, attitude, compass). Every field is optional;\nomission keeps the built-in value. The colour fields that carry a meaning must keep it: the\nmanifest is rejected if a meaning colour has the wrong hue family.",
      "type": "object",
      "properties": {
        "box_border": {
          "anyOf": [
            {
              "$ref": "#/$defs/SrgbHex"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "box_fill": {
          "anyOf": [
            {
              "$ref": "#/$defs/SrgbHex"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "box_text": {
          "anyOf": [
            {
              "$ref": "#/$defs/SrgbHex"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cyan": {
          "description": "Selected values and their bugs: heading, altitude, and the cyan family.",
          "anyOf": [
            {
              "$ref": "#/$defs/SrgbHex"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "green": {
          "description": "Active modes and a valid VOR or localizer: the green family.",
          "anyOf": [
            {
              "$ref": "#/$defs/SrgbHex"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ground": {
          "anyOf": [
            {
              "$ref": "#/$defs/SrgbHex"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "magenta": {
          "description": "Trend vectors, flight director bars, and GPS course guidance: the magenta family.",
          "anyOf": [
            {
              "$ref": "#/$defs/SrgbHex"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "red": {
          "description": "Warnings and failure flags: the red family.",
          "anyOf": [
            {
              "$ref": "#/$defs/SrgbHex"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sky": {
          "anyOf": [
            {
              "$ref": "#/$defs/SrgbHex"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tape_fill": {
          "anyOf": [
            {
              "$ref": "#/$defs/SrgbHex"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tape_text": {
          "anyOf": [
            {
              "$ref": "#/$defs/SrgbHex"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "white": {
          "description": "Scale marks, armed modes, and unselected values. Must be near white.",
          "anyOf": [
            {
              "$ref": "#/$defs/SrgbHex"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "yellow": {
          "description": "Cautions and the aircraft symbol: the yellow family.",
          "anyOf": [
            {
              "$ref": "#/$defs/SrgbHex"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "InstrumentStyle": {
      "description": "Instrument-face style: palette and typography. No geometry: placement belongs to the model.",
      "type": "object",
      "properties": {
        "palette": {
          "$ref": "#/$defs/InstrumentPalette",
          "default": {
            "box_border": null,
            "box_fill": null,
            "box_text": null,
            "cyan": null,
            "green": null,
            "ground": null,
            "magenta": null,
            "red": null,
            "sky": null,
            "tape_fill": null,
            "tape_text": null,
            "white": null,
            "yellow": null
          }
        },
        "typography": {
          "$ref": "#/$defs/InstrumentTypography",
          "default": {
            "annunciation_text": null,
            "box_text": null,
            "data_bar_text": null,
            "tape_text": null
          }
        }
      },
      "additionalProperties": false
    },
    "InstrumentTypography": {
      "description": "Type size multipliers for the instrument faces, each 0.7 to 1.4. Omission keeps 1.0.",
      "type": "object",
      "properties": {
        "annunciation_text": {
          "type": [
            "number",
            "null"
          ],
          "format": "float",
          "default": null
        },
        "box_text": {
          "type": [
            "number",
            "null"
          ],
          "format": "float",
          "default": null
        },
        "data_bar_text": {
          "type": [
            "number",
            "null"
          ],
          "format": "float",
          "default": null
        },
        "tape_text": {
          "type": [
            "number",
            "null"
          ],
          "format": "float",
          "default": null
        }
      },
      "additionalProperties": false
    },
    "SkinAsset": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/SkinAssetKind"
        },
        "licence": {
          "description": "SPDX licence identifier of the asset itself.",
          "type": "string"
        },
        "path": {
          "description": "Portable relative path inside the skin directory.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "licence"
      ]
    },
    "SkinAssetKind": {
      "type": "string",
      "enum": [
        "font"
      ]
    },
    "SkinPalette": {
      "description": "Colours for the bezel and its controls. Every field is optional; omission keeps the built-in value.",
      "type": "object",
      "properties": {
        "bezel": {
          "anyOf": [
            {
              "$ref": "#/$defs/SrgbHex"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "bezel_trim": {
          "anyOf": [
            {
              "$ref": "#/$defs/SrgbHex"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "key_face": {
          "anyOf": [
            {
              "$ref": "#/$defs/SrgbHex"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "key_text": {
          "anyOf": [
            {
              "$ref": "#/$defs/SrgbHex"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "knob": {
          "anyOf": [
            {
              "$ref": "#/$defs/SrgbHex"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "knob_mark": {
          "anyOf": [
            {
              "$ref": "#/$defs/SrgbHex"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "screen_surround": {
          "anyOf": [
            {
              "$ref": "#/$defs/SrgbHex"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "SrgbHex": {
      "description": "Six-digit opaque sRGB, including the leading `#`.",
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    }
  }
}
