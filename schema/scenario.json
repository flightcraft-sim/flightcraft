{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scenario",
  "type": "object",
  "properties": {
    "ai_written": {
      "type": "boolean",
      "default": false
    },
    "id": {
      "type": "string"
    },
    "procedures": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "route": {
      "description": "Route samples carry explicit MSL altitude and clearance assumptions.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/RoutePoint"
      }
    },
    "seed": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ScenarioStep"
      }
    },
    "title": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "format": "uint8",
      "maximum": 255,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "title",
    "seed",
    "route",
    "steps"
  ],
  "$defs": {
    "ApproachIntercept": {
      "description": "A heading and altitude restriction remain in force until the final course is established.",
      "type": "object",
      "properties": {
        "altitude_ft": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "heading_deg": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "turn_left": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "heading_deg",
        "altitude_ft",
        "turn_left"
      ]
    },
    "AtcInstruction": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "altitude_ft": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "efc_utc": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "fix": {
              "type": "string"
            },
            "inbound_deg": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "hold"
            },
            "leg_distance_nm": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "leg_time_s": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "right_turns": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "fix",
            "inbound_deg",
            "right_turns",
            "altitude_ft",
            "efc_utc"
          ]
        },
        {
          "type": "object",
          "properties": {
            "airport": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "missed_approach"
            },
            "procedure": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "airport",
            "procedure"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "parking"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "hold_short": {
              "type": "boolean"
            },
            "kind": {
              "type": "string",
              "const": "taxi"
            },
            "route": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "runway": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "runway",
            "route",
            "hold_short"
          ]
        },
        {
          "type": "object",
          "properties": {
            "closed_traffic": {
              "type": "boolean"
            },
            "kind": {
              "type": "string",
              "const": "takeoff"
            },
            "runway": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "runway",
            "closed_traffic"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "land"
            },
            "runway": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "runway"
          ]
        },
        {
          "type": "object",
          "properties": {
            "entry": {
              "$ref": "#/$defs/PatternEntry"
            },
            "follow": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "type": "string",
              "const": "pattern"
            },
            "number": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "runway": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "runway",
            "entry",
            "number"
          ]
        },
        {
          "description": "Touch-and-go landing clearance (JO 7110.65 3-9-4); used for circuit traffic.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "touch_and_go"
            },
            "runway": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "runway"
          ]
        },
        {
          "description": "Speed adjustment (JO 7110.65 5-7-1); `None` cancels the restriction.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "speed"
            },
            "knots": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "extend_downwind"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "go_around"
            },
            "runway": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "runway"
          ]
        },
        {
          "type": "object",
          "properties": {
            "altitude_ft": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "heading_deg": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "vector"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "heading_deg",
            "altitude_ft"
          ]
        },
        {
          "type": "object",
          "properties": {
            "altitude_ft": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "altitude"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "altitude_ft"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "ident": {
              "description": "\"Squawk ... and ident\": the controller also wants the IDENT button pressed.",
              "type": "boolean"
            },
            "kind": {
              "type": "string",
              "const": "squawk"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "code"
          ]
        },
        {
          "description": "\"Ident\": press IDENT on the transponder (radar identification).",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "ident"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "channel_khz": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "handoff"
            },
            "station_id": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "station_id",
            "channel_khz"
          ]
        },
        {
          "type": "object",
          "properties": {
            "altitude_ft": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "cleared": {
              "type": "boolean"
            },
            "heading_deg": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "bravo"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "cleared",
            "heading_deg",
            "altitude_ft"
          ]
        },
        {
          "type": "object",
          "properties": {
            "airport": {
              "type": "string"
            },
            "intercept": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ApproachIntercept"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "approach"
            },
            "name": {
              "type": "string"
            },
            "procedure": {
              "type": "string"
            },
            "runway": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "airport",
            "procedure",
            "name",
            "runway"
          ]
        },
        {
          "type": "object",
          "properties": {
            "altitude_ft": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "code": {
              "type": "string"
            },
            "departure_khz": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "destination": {
              "type": "string"
            },
            "destination_name": {
              "type": "string"
            },
            "expect_minutes": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "expected_altitude_ft": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "ifr_clearance"
            },
            "route": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "destination",
            "destination_name",
            "expected_altitude_ft",
            "expect_minutes",
            "route",
            "altitude_ft",
            "departure_khz",
            "code"
          ]
        },
        {
          "type": "object",
          "properties": {
            "ground_khz": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "exit_runway"
            },
            "runway": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "runway",
            "ground_khz"
          ]
        }
      ]
    },
    "CloudLayer": {
      "type": "object",
      "properties": {
        "base_ft_msl": {
          "type": "number",
          "format": "double",
          "maximum": 60000,
          "minimum": -1500
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "top_ft_msl": {
          "type": "number",
          "format": "double",
          "maximum": 60000,
          "minimum": -1500
        }
      },
      "additionalProperties": false,
      "required": [
        "base_ft_msl",
        "top_ft_msl",
        "coverage"
      ]
    },
    "Conditions": {
      "type": "object",
      "properties": {
        "dewpoint_c": {
          "type": "number",
          "format": "double",
          "default": 5.0
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CloudLayer"
          },
          "maxItems": 3
        },
        "obscuration": {
          "$ref": "#/$defs/Obscuration"
        },
        "precipitation": {
          "$ref": "#/$defs/Precipitation"
        },
        "sea_level_pressure_pa": {
          "type": "number",
          "format": "double",
          "default": 101325.0
        },
        "temperature_c": {
          "description": "Sea-level reference observations; station temperature uses a standard lapse rate.",
          "type": "number",
          "format": "double",
          "default": 15.0
        },
        "time_of_day": {
          "$ref": "#/$defs/TimeOfDay"
        },
        "visibility_sm": {
          "type": "number",
          "format": "double",
          "maximum": 100,
          "minimum": 0.125
        }
      },
      "additionalProperties": false,
      "required": [
        "layers",
        "visibility_sm",
        "obscuration",
        "precipitation",
        "time_of_day"
      ]
    },
    "ControlSurface": {
      "type": "string",
      "enum": [
        "elevator",
        "aileron",
        "rudder",
        "flaps"
      ]
    },
    "Coverage": {
      "type": "string",
      "enum": [
        "FEW",
        "SCT",
        "BKN",
        "OVC"
      ]
    },
    "FacilityKind": {
      "type": "string",
      "enum": [
        "ctaf",
        "unicom",
        "awos",
        "asos",
        "atis",
        "tower",
        "ground",
        "approach",
        "departure",
        "clearance"
      ]
    },
    "Failure": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "engine_fire"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "electrical_fire"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "cabin_smoke"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "door_open"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "carb_icing"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "airframe_icing"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "flap_asymmetry"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "trim_runaway"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "trim_stuck"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "radio_failure"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "engine"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "vacuum_pump"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "alternator"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "pitot_blocked"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "static_blocked"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "fraction": {
              "type": "number",
              "format": "double",
              "maximum": 1,
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "partial_power"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "fraction"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "jam"
            },
            "position": {
              "description": "Fixed normalised deflection; flaps require 0..=1.",
              "type": "number",
              "format": "double",
              "maximum": 1,
              "minimum": -1
            },
            "surface": {
              "$ref": "#/$defs/ControlSurface"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "surface",
            "position"
          ]
        }
      ]
    },
    "FailureTarget": {
      "type": "string",
      "enum": [
        "engine_fire",
        "electrical_fire",
        "cabin_smoke",
        "door_open",
        "carb_icing",
        "airframe_icing",
        "flap_asymmetry",
        "trim_runaway",
        "trim_stuck",
        "radio_failure",
        "all",
        "vacuum_pump",
        "alternator",
        "pitot_blocked",
        "static_blocked",
        "engine",
        "elevator",
        "aileron",
        "rudder",
        "flaps"
      ]
    },
    "FlightPhase": {
      "type": "string",
      "enum": [
        "taxi",
        "takeoff",
        "climb",
        "cruise",
        "descent",
        "approach",
        "landed"
      ]
    },
    "Instruction": {
      "description": "Typed meaning shared by scripted and live facility transmissions. No automatic ATC rules.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "instruction": {
              "$ref": "#/$defs/AtcInstruction"
            },
            "kind": {
              "type": "string",
              "const": "controller"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "instruction"
          ]
        },
        {
          "type": "object",
          "properties": {
            "airport": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "land"
            },
            "runway": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "airport",
            "runway"
          ]
        },
        {
          "type": "object",
          "properties": {
            "airport": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "go_around"
            },
            "runway": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "airport",
            "runway"
          ]
        },
        {
          "type": "object",
          "properties": {
            "altitude_msl_m": {
              "type": "number",
              "format": "double"
            },
            "at": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "altitude"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "altitude_msl_m",
            "at"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "airspace_clearance"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "request_readback"
            },
            "text": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "advisory"
            },
            "text": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ]
        }
      ]
    },
    "Obscuration": {
      "type": "string",
      "enum": [
        "none",
        "mist",
        "fog",
        "haze"
      ]
    },
    "PatternEntry": {
      "type": "string",
      "enum": [
        "straight_in",
        "left_downwind",
        "right_downwind",
        "left_base",
        "right_base"
      ]
    },
    "Precipitation": {
      "type": "string",
      "enum": [
        "none",
        "rain",
        "snow"
