{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Request",
  "type": "object",
  "properties": {
    "allow_http": {
      "description": "Explicit consent to the exact reviewed TUM HTTP prefix; never permits other HTTP URLs.",
      "type": "boolean",
      "default": false
    },
    "area": {
      "type": "string"
    },
    "cache": {
      "type": "string"
    },
    "operation": {
      "$ref": "#/$defs/Operation"
    },
    "out": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "sample": {
      "description": "Offline reference image, only for the documented 1N7 NAIP sample bbox.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "operation",
    "region",
    "area",
    "cache",
    "out"
  ],
  "$defs": {
    "Operation": {
      "type": "string",
      "enum": [
        "fetch",
        "build"
      ]
    }
  }
}
