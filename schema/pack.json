{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PackManifest",
  "type": "object",
  "properties": {
    "affiliation": {
      "type": "string"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1
    },
    "exterior": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Exterior"
      },
      "maxItems": 16
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PackFile"
      },
      "maxItems": 64,
      "minItems": 1
    },
    "format_version": {
      "description": "Legacy manifests remain readable; exteriors require >=2 and slide motion >=3.",
      "type": "integer",
      "format": "uint32",
      "default": 1,
      "maximum": 3,
      "minimum": 1
    },
    "id": {
      "type": "string"
    },
    "licence": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "not": {
          "properties": {
            "format_version": {
              "enum": [
                2,
                3
              ]
            }
          },
          "required": [
            "format_version"
          ]
        }
      },
      "then": {
        "properties": {
          "exterior": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "not": {
          "properties": {
            "format_version": {
              "const": 3
            }
          },
          "required": [
            "format_version"
          ]
        }
      },
      "then": {
        "properties": {
          "exterior": {
            "items": {
              "properties": {
                "moving_parts": {
                  "items": {
                    "properties": {
                      "motion": {
                        "not": {
                          "const": "slide"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "required": [
    "id",
    "name",
    "version",
    "licence",
    "authors",
    "affiliation",
    "files"
  ],
  "$defs": {
    "Exterior": {
      "type": "object",
      "properties": {
        "aircraft": {
          "type": "string"
        },
        "height_m": {
          "type": "number",
          "format": "float",
          "maximum": 100,
          "minimum": 0.01
        },
        "interior": {
          "description": "Authored cabin and pilot eye in pack body coordinates (before CG subtraction).",
          "anyOf": [
            {
              "$ref": "#/$defs/Interior"
            },
            {
              "type": "null"
            }
          ]
        },
        "length_m": {
          "type": "number",
          "format": "float",
          "maximum": 100,
          "minimum": 0.01
        },
        "lights": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExteriorLight"
          },
          "maxItems": 16
        },
        "lod1": {
          "type": "string"
        },
        "lod2": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": "string"
        },
        "moving_parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MovingPart"
          },
          "maxItems": 64
        },
        "prop_diameter_m": {
          "type": "number",
          "format": "float",
          "maximum": 100,
          "minimum": 0.01
        },
        "registration": {
          "$ref": "#/$defs/Registration"
        },
        "span_m": {
          "type": "number",
          "format": "float",
          "maximum": 100,
          "minimum": 0.01
        },
        "textures": {
          "description": "Pack-root PNG paths. GLB image URIs resolve relative to their model file.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 8
        },
        "wing_area_m2": {
          "type": "number",
          "format": "float",
          "maximum": 100,
          "minimum": 0.01
        }
      },
      "additionalProperties": false,
      "required": [
        "aircraft",
        "model",
        "lod1",
        "span_m",
        "length_m",
        "height_m",
        "wing_area_m2",
        "prop_diameter_m",
        "moving_parts",
        "lights",
        "registration"
      ]
    },
    "ExteriorLight": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/LightKind"
        },
        "node": {
          "type": "string"
        },
        "power_load": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "node",
        "kind"
      ]
    },
    "FileKind": {
      "type": "string",
      "enum": [
        "family",
        "variant",
        "engine",
        "systems",
        "panel",
        "aircraft"
      ]
    },
    "Interior": {
      "type": "object",
      "properties": {
        "pilot_eye_m": {
          "type": "array",
          "items": {
            "type": "number",
            "maximum": 10,
            "minimum": -10
          },
          "maxItems": 3,
          "minItems": 3
        }
      },
      "additionalProperties": false,
      "required": [
        "pilot_eye_m"
      ]
    },
    "LightKind": {
      "type": "string",
      "enum": [
        "nav_red",
        "nav_green",
        "nav_white",
        "strobe",
        "beacon",
        "landing"
      ]
    },
    "Motion": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "aileron",
            "elevator",
            "rudder",
            "flaps",
            "propeller",
            "prop_blur",
            "steering",
            "wheel",
            "oleo"
          ]
        },
        {
          "description": "Linear translation driven by canopy open fraction (pack format 3).",
          "type": "string",
          "const": "slide"
        }
      ]
    },
    "MovingPart": {
      "type": "object",
      "properties": {
        "axis": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "gear_index": {
          "type": "integer",
          "format": "uint",
          "default": 0,
          "maximum": 15,
          "minimum": 0
        },
        "motion": {
          "$ref": "#/$defs/Motion"
        },
        "node": {
          "type": "string"
        },
        "travel_m": {
          "description": "Closed-to-open translation along the unit local axis; slide only.",
          "type": [
            "number",
            "null"
          ],
          "format": "float",
          "maximum": 3,
          "minimum": 0.01
        },
        "travel_rad": {
          "description": "Angles at normalized -1 and +1 (flaps use 0 and 1).",
          "type": "array",
          "default": [
            0.0,
            0.0
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "wheel_radius_m": {
          "type": "number",
          "format": "float",
          "default": 0.1899999976158142,
          "maximum": 2,
          "minimum": 0.01
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "motion": {
              "const": "slide"
            },
            "travel_m": {
              "type": "number",
              "maximum": 3,
              "minimum": 0.01
            },
            "travel_rad": {
              "const": [
                0,
                0
              ]
            }
          },
          "required": [
            "travel_m"
          ]
        },
        {
          "properties": {
            "motion": {
              "not": {
                "const": "slide"
              }
            }
          },
          "not": {
            "required": [
              "travel_m"
            ]
          },
          "required": [
            "travel_rad"
          ]
        }
      ],
      "required": [
        "node",
        "motion",
        "axis"
      ]
    },
    "PackFile": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/FileKind"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "kind"
      ]
    },
    "Registration": {
      "type": "object",
      "properties": {
        "node": {
          "type": "string"
        },
        "surface": {
          "description": "Body-space patch for replacing registration baked into the base-color atlas.",
          "anyOf": [
            {
              "$ref": "#/$defs/RegistrationSurface"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 16,
          "minLength": 1,
          "pattern": "^[A-Z0-9-]+$"
        }
      },
      "additionalProperties": false,
      "required": [
        "node",
        "text"
      ]
    },
    "RegistrationSurface": {
      "type": "object",
      "properties": {
        "background": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "color": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "height_m": {
          "type": "number",
          "format": "float"
        },
        "node": {
          "type": "string"
        },
        "x_m": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "z_m": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 2,
          "minItems": 2
        }
      },
      "additionalProperties": false,
      "required": [
        "node",
        "x_m",
        "z_m",
        "height_m",
        "background",
        "color"
      ]
    }
  }
}
