{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lock",
  "type": "object",
  "properties": {
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Asset"
      }
    },
    "base_url": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "format": "uint8",
      "maximum": 255,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "base_url",
    "assets"
  ],
  "$defs": {
    "Asset": {
      "type": "object",
      "properties": {
        "asset": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "dataset": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FileEntry"
          }
        },
        "region": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "region",
        "dataset",
        "tag",
        "asset",
        "bytes",
        "sha256",
        "files"
      ]
    },
    "FileEntry": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ]
    }
  }
}
