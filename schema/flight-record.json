{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FlightRecord",
  "type": "object",
  "properties": {
    "dropped_events": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "dropped_inputs": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "emergency": {
      "anyOf": [
        {
          "$ref": "#/$defs/EmergencyDebrief"
        },
        {
          "type": "null"
        }
      ]
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Transmission"
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RecordedInput"
      }
    },
    "version": {
      "type": "integer",
      "format": "uint8",
      "maximum": 1,
      "minimum": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "events",
    "inputs",
    "dropped_events",
    "dropped_inputs"
  ],
  "$defs": {
    "CallGrade": {
      "type": "object",
      "properties": {
        "airport_correct": {
          "type": "boolean"
        },
        "expected_leg": {
          "anyOf": [
            {
              "$ref": "#/$defs/PatternLeg"
            },
            {
              "type": "null"
            }
          ]
        },
        "feedback": {
          "type": "string"
        },
        "frequency_correct": {
          "type": "boolean"
        },
        "passed": {
          "type": "boolean"
        },
        "received": {
          "type": "boolean"
        },
        "runway_correct": {
          "type": "boolean"
        },
        "timely": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "airport_correct",
        "runway_correct",
        "frequency_correct",
        "timely",
        "received",
        "passed",
        "feedback"
      ]
    },
    "Channel": {
      "type": "string",
      "enum": [
        "com",
        "intercom",
        "nav"
      ]
    },
    "CloudLayer": {
      "type": "object",
      "properties": {
        "base_ft_msl": {
          "type": "number",
          "format": "double",
          "maximum": 60000,
          "minimum": -1500
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "top_ft_msl": {
          "type": "number",
          "format": "double",
          "maximum": 60000,
          "minimum": -1500
        }
      },
      "additionalProperties": false,
      "required": [
        "base_ft_msl",
        "top_ft_msl",
        "coverage"
      ]
    },
    "Conditions": {
      "type": "object",
      "properties": {
        "dewpoint_c": {
          "type": "number",
          "format": "double",
          "default": 5.0
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CloudLayer"
          },
          "maxItems": 3
        },
        "obscuration": {
          "$ref": "#/$defs/Obscuration"
        },
        "precipitation": {
          "$ref": "#/$defs/Precipitation"
        },
        "sea_level_pressure_pa": {
          "type": "number",
          "format": "double",
          "default": 101325.0
        },
        "temperature_c": {
          "description": "Sea-level reference observations; station temperature uses a standard lapse rate.",
          "type": "number",
          "format": "double",
          "default": 15.0
        },
        "time_of_day": {
          "$ref": "#/$defs/TimeOfDay"
        },
        "visibility_sm": {
          "type": "number",
          "format": "double",
          "maximum": 100,
          "minimum": 0.125
        }
      },
      "additionalProperties": false,
      "required": [
        "layers",
        "visibility_sm",
        "obscuration",
        "precipitation",
        "time_of_day"
      ]
    },
    "ControlSurface": {
      "type": "string",
      "enum": [
        "elevator",
        "aileron",
        "rudder",
        "flaps"
      ]
    },
    "Controls": {
      "description": "Pilot controls. Each value is clamped to its range when set.",
      "type": "object",
      "properties": {
        "aileron": {
          "description": "Aileron, -1 (roll left) to 1 (roll right).",
          "type": "number",
          "format": "double"
        },
        "brake": {
          "description": "Wheel brakes, 0 to 1.",
          "type": "number",
          "format": "double"
        },
        "elevator": {
          "description": "Elevator, -1 (nose down) to 1 (nose up).",
          "type": "number",
          "format": "double"
        },
        "flaps": {
          "description": "Flaps, 0 (up) to 1 (fully down).",
          "type": "number",
          "format": "double"
        },
        "rudder": {
          "description": "Rudder, -1 (yaw left) to 1 (yaw right).",
          "type": "number",
          "format": "double"
        },
        "throttle": {
          "description": "Throttle, 0 to 1.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "elevator",
        "aileron",
        "rudder",
        "throttle",
        "flaps",
        "brake"
      ]
    },
    "Coverage": {
      "type": "string",
      "enum": [
        "FEW",
        "SCT",
        "BKN",
        "OVC"
      ]
    },
    "EmergencyDebrief": {
      "type": "object",
      "properties": {
        "chosen_field": {
          "type": [
            "string",
            "null"
          ]
        },
        "emergency_call": {
          "type": "boolean"
        },
        "failure_agl_m": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "failure_location": {
          "type": "string",
          "default": ""
        },
        "failure_time_s": {
          "type": "number",
          "format": "double"
        },
        "field_reachable": {
          "type": "boolean"
        },
        "frequency_at_failure_khz": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "glide": {
          "$ref": "#/$defs/GlideFootprint"
        },
        "has_been_airborne": {
          "type": "boolean"
        },
        "landed_at_chosen_field": {
          "type": "boolean"
        },
        "last_sample_time_s": {
          "type": "number",
          "format": "double"
        },
        "outcome": {
          "type": "string"
        },
        "procedure": {
          "$ref": "#/$defs/EmergencyProcedure"
        },
        "recognition_s": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "source": {
          "$ref": "#/$defs/EventSource"
        },
        "speed_in_tolerance": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "speed_samples": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "squawk_7700": {
          "type": "boolean"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EmergencyTiming"
          }
        },
        "touchdown_m": {
          "type": [
            "array",
            "null"
          ],
          "default": null,
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "track_m": {
          "type": "array",
          "default": [],
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            },
            "maxItems": 3,
            "minItems": 3
          }
        }
      },
      "required": [
        "failure_time_s",
        "source",
        "procedure",
        "glide",
        "steps",
        "field_reachable",
        "speed_samples",
        "speed_in_tolerance",
        "emergency_call",
        "frequency_at_failure_khz",
        "landed_at_chosen_field",
        "squawk_7700",
        "outcome",
        "has_been_airborne",
        "last_sample_time_s"
      ]
    },
    "EmergencyItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "instruction": {
          "type": "string"
        },
        "memory": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "instruction",
        "memory"
      ]
    },
    "EmergencyProcedure": {
      "type": "object",
      "properties": {
        "best_glide_mps": {
          "type": "number",
          "format": "double"
        },
        "glide_ratio": {
          "type": "number",
          "format": "double"
        },
        "id": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EmergencyItem"
          }
        },
        "speed_tolerance_mps": {
          "type": "number",
          "format": "double"
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "best_glide_mps",
        "glide_ratio",
        "speed_tolerance_mps",
        "items"
      ]
    },
    "EmergencyTiming": {
      "type": "object",
      "properties": {
        "elapsed_s": {
          "type": "number",
          "format": "double"
        },
        "in_order": {
          "type": "boolean"
        },
        "item": {
          "type": "string"
        }
      },
      "required": [
        "item",
        "elapsed_s",
        "in_order"
      ]
    },
    "EventSource": {
      "type": "string",
      "enum": [
        "rules",
        "scenario",
        "scenario (ai-written)",
        "ai",
        "pilot"
      ]
    },
    "FacilityKind": {
      "type": "string",
      "enum": [
        "ctaf",
        "unicom",
        "awos",
        "asos",
        "atis",
        "tower",
        "ground",
        "approach",
        "departure",
        "clearance"
      ]
    },
    "Failure": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "engine_fire"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "electrical_fire"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "cabin_smoke"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "door_open"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "carb_icing"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "airframe_icing"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "flap_asymmetry"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "trim_runaway"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "trim_stuck"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "radio_failure"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "engine"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "vacuum_pump"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "alternator"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "pitot_blocked"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "static_blocked"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "fraction": {
              "type": "number",
              "format": "double",
              "maximum": 1,
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "partial_power"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "fraction"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "jam"
            },
            "position": {
              "description": "Fixed normalised deflection; flaps require 0..=1.",
              "type": "number",
              "format": "double",
              "maximum": 1,
              "minimum": -1
            },
            "surface": {
              "$ref": "#/$defs/ControlSurface"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "surface",
            "position"
          ]
        }
      ]
    },
    "FailureTarget": {
      "type": "string",
      "enum": [
        "engine_fire",
        "electrical_fire",
        "cabin_smoke",
        "door_open",
        "carb_icing",
        "airframe_icing",
        "flap_asymmetry",
        "trim_runaway",
        "trim_stuck",
        "radio_failure",
        "all",
        "vacuum_pump",
        "alternator",
        "pitot_blocked",
        "static_blocked",
        "engine",
        "elevator",
        "aileron",
        "rudder",
        "flaps"
      ]
    },
    "FlightPhase": {
      "type": "string",
      "enum": [
        "taxi",
        "takeoff",
        "climb",
        "cruise",
        "descent",
        "approach",
        "landed"
      ]
    },
    "GlideField": {
      "type": "object",
      "properties": {
        "airport": {
          "type": "boolean"
        },
        "heading_grid_rad": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "id": {
          "type": "string"
        },
        "length_m": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "position_m": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "slope_percent": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "terrain_msl_m": {
          "type": "number",
          "format": "double"
        },
        "width_m": {
          "type": "number",
          "format": "double",
          "default": 0.0
        }
      },
      "required": [
        "id",
        "position_m",
        "terrain_msl_m",
        "airport"
      ]
    },
    "GlideFootprint": {
      "type": "object",
      "properties": {
        "best_glide_mps": {
          "type": "number",
          "format": "double"
        },
        "boundary_m": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            },
            "maxItems": 2,
            "minItems": 2
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GlideField"
          }
        },
        "glide_ratio": {
          "type": "number",
          "format": "double"
        },
        "origin_m": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "terrain_coverage_limited": {
          "type": "boolean"
        },
        "wind_ned_mps": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "world": {
          "$ref": "#/$defs/WorldChoice"
        }
      },
      "required": [
        "world",
        "origin_m",
        "boundary_m",
        "wind_ned_mps",
        "glide_ratio",
        "best_glide_mps",
        "fields",
        "terrain_coverage_limited"
      ]
    },
    "Instruction": {
      "description": "Typed meaning shared by scripted and live facility transmissions. No automatic ATC rules.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "airport": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "land"
            },
            "runway": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "airport",
            "runway"
          ]
        },
        {
          "type": "object",
          "properties": {
            "airport": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "go_around"
            },
            "runway": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "airport",
            "runway"
          ]
        },
        {
          "type": "object",
          "properties": {
            "altitude_msl_m": {
              "type": "number",
              "format": "double"
            },
            "at": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "altitude"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "altitude_msl_m",
            "at"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "airspace_clearance"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "request_readback"
            },
            "text": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "advisory"
            },
            "text": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ]
        }
      ]
    },
    "Meaning": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "$ref": "#/$defs/ScenarioAction"
            },
            "type": {
              "type": "string",
              "const": "scenario_action"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "action"
          ]
        },
        {
          "type": "object",
          "properties": {
            "instruction": {
              "$ref": "#/$defs/Instruction"
            },
            "type": {
              "type": "string",
              "const": "scenario"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "instruction"
          ]
        },
        {
          "type": "object",
          "properties": {
            "airport": {
              "type": "string"
            },
            "leg": {
              "$ref": "#/$defs/PatternLeg"
            },
            "runway": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "position"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "airport",
            "runway",
            "leg"
          ]
        },
        {
          "type": "object",
          "properties": {
            "airport": {
              "type": "string"
            },
            "altimeter_pa": {
              "type": "number",
              "format": "double"
            },
            "ceiling_agl_m": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "dewpoint_c": {
              "type": "number",
              "format": "double",
              "default": 0.0
            },
            "layers": {
              "type": "array",
              "default": [],
              "items": {
                "$ref": "#/$defs/ReportedLayer"
              }
            },
            "obscuration": {
              "$ref": "#/$defs/Obscuration",
              "default": "none"
            },
            "precipitation": {
              "$ref": "#/$defs/Precipitation",
              "default": "none"
            },
            "temperature_c": {
              "type": "number",
              "format": "double",
              "default": 0.0
            },
            "type": {
              "type": "string",
              "const": "weather"
            },
            "visibility_m": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "wind_from_deg": {
              "type": "number",
              "format": "double"
            },
