{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WeatherSource",
  "type": "object",
  "properties": {
    "advisory_only": {
      "type": "boolean"
    },
    "airport": {
      "type": "string",
      "maxLength": 8,
      "minLength": 3,
      "pattern": "^[A-Z0-9]+$"
    },
    "allow_http": {
      "type": "boolean"
    },
    "cors": {
      "description": "Browser opt-in; the server must also send Access-Control-Allow-Origin.",
      "type": "boolean",
      "default": false
    },
    "disclaimer": {
      "type": "string",
      "maxLength": 1024
    },
    "extraction": {
      "$ref": "#/$defs/Extraction"
    },
    "format_version": {
      "type": "integer",
      "format": "uint32",
      "maximum": 1,
      "minimum": 1
    },
    "id": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "name": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    },
    "refresh_seconds": {
      "type": "integer",
      "format": "uint32",
      "maximum": 86400,
      "minimum": 60
    },
    "timeout_seconds": {
      "type": "integer",
      "format": "uint32",
      "maximum": 120,
      "minimum": 1
    },
    "url": {
      "type": "string",
      "maxLength": 2048,
      "minLength": 1,
      "pattern": "^https?://"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "url": {
            "pattern": "^http://"
          }
        },
        "required": [
          "url"
        ]
      },
      "then": {
        "properties": {
          "allow_http": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "advisory_only": {
            "const": true
          }
        },
        "required": [
          "advisory_only"
        ]
      },
      "then": {
        "properties": {
          "disclaimer": {
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "extraction": {
            "properties": {
              "kind": {
                "const": "digiwx"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "extraction"
        ]
      },
      "then": {
        "properties": {
          "advisory_only": {
            "const": true
          }
        }
      }
    }
  ],
  "required": [
    "format_version",
    "id",
    "name",
    "airport",
    "url",
    "allow_http",
    "refresh_seconds",
    "timeout_seconds",
    "advisory_only",
    "disclaimer",
    "extraction"
  ],
  "$defs": {
    "Extraction": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "digiwx"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "metar_text"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "aviationweather"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "fields": {
              "$ref": "#/$defs/Fields",
              "default": {
                "altimeter": null,
                "ceiling": null,
                "date": null,
                "dew_point": null,
                "gust": null,
                "layers": null,
                "runway_in_use": null,
                "temperature": null,
                "time": null,
                "visibility": null,
                "wind": null
              }
            },
            "kind": {
              "type": "string",
              "const": "metar"
            },
            "selector": {
              "$ref": "#/$defs/Selector"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "selector"
          ]
        },
        {
          "type": "object",
          "properties": {
            "fields": {
              "$ref": "#/$defs/Fields"
            },
            "kind": {
              "type": "string",
              "const": "fields"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "fields"
          ]
        }
      ]
    },
    "Fields": {
      "type": "object",
      "properties": {
        "altimeter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Selector"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ceiling": {
          "anyOf": [
            {
              "$ref": "#/$defs/Selector"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "date": {
          "anyOf": [
            {
              "$ref": "#/$defs/Selector"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dew_point": {
          "anyOf": [
            {
              "$ref": "#/$defs/Selector"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "gust": {
          "anyOf": [
            {
              "$ref": "#/$defs/Selector"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "layers": {
          "anyOf": [
            {
              "$ref": "#/$defs/Selector"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "runway_in_use": {
          "anyOf": [
            {
              "$ref": "#/$defs/Selector"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "temperature": {
          "anyOf": [
            {
              "$ref": "#/$defs/Selector"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "time": {
          "anyOf": [
            {
              "$ref": "#/$defs/Selector"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "visibility": {
          "anyOf": [
            {
              "$ref": "#/$defs/Selector"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "wind": {
          "anyOf": [
            {
              "$ref": "#/$defs/Selector"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "Selector": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "element_id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "element_id"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "element_id"
          ]
        },
        {
          "title": "id, .class, #id.class, or .class.other; no combinators or executable expressions.",
          "type": "object",
          "properties": {
            "css_like": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "css_like"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "css_like"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "regex"
            },
            "regex": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "regex"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "body"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "json_pointer": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "json_pointer"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "json_pointer"
          ]
        }
      ]
    }
  }
}
