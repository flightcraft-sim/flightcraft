{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Conditions",
  "type": "object",
  "properties": {
    "dewpoint_c": {
      "type": "number",
      "format": "double",
      "default": 5.0
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CloudLayer"
      },
      "maxItems": 3
    },
    "obscuration": {
      "$ref": "#/$defs/Obscuration"
    },
    "precipitation": {
      "$ref": "#/$defs/Precipitation"
    },
    "sea_level_pressure_pa": {
      "type": "number",
      "format": "double",
      "default": 101325.0
    },
    "temperature_c": {
      "description": "Sea-level reference observations; station temperature uses a standard lapse rate.",
      "type": "number",
      "format": "double",
      "default": 15.0
    },
    "time_of_day": {
      "$ref": "#/$defs/TimeOfDay"
    },
    "visibility_sm": {
      "type": "number",
      "format": "double",
      "maximum": 100,
      "minimum": 0.125
    }
  },
  "additionalProperties": false,
  "required": [
    "layers",
    "visibility_sm",
    "obscuration",
    "precipitation",
    "time_of_day"
  ],
  "$defs": {
    "CloudLayer": {
      "type": "object",
      "properties": {
        "base_ft_msl": {
          "type": "number",
          "format": "double",
          "maximum": 60000,
          "minimum": -1500
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "top_ft_msl": {
          "type": "number",
          "format": "double",
          "maximum": 60000,
          "minimum": -1500
        }
      },
      "additionalProperties": false,
      "required": [
        "base_ft_msl",
        "top_ft_msl",
        "coverage"
      ]
    },
    "Coverage": {
      "type": "string",
      "enum": [
        "FEW",
        "SCT",
        "BKN",
        "OVC"
      ]
    },
    "Obscuration": {
      "type": "string",
      "enum": [
        "none",
        "mist",
        "fog",
        "haze"
      ]
    },
    "Precipitation": {
      "type": "string",
      "enum": [
        "none",
        "rain",
        "snow"
      ]
    },
    "TimeOfDay": {
      "type": "string",
      "enum": [
        "day",
        "dusk",
        "night",
        "dawn"
      ]
    }
  }
}
