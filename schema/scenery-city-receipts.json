{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Array_of_Source",
  "type": "array",
  "items": {
    "$ref": "#/$defs/Source"
  },
  "$defs": {
    "Source": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "downloaded_at": {
          "type": "string"
        },
        "edition": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "url",
        "downloaded_at",
        "bytes",
        "sha256"
      ]
    }
  }
}
