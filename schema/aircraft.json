{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LayerFile",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "aerodynamics": {
          "$ref": "#/$defs/Aerodynamics"
        },
        "controls": {
          "$ref": "#/$defs/AirframeControls"
        },
        "format_version": {
          "type": "integer",
          "format": "uint32",
          "maximum": 2,
          "minimum": 2
        },
        "geometry": {
          "$ref": "#/$defs/Geometry"
        },
        "identity": {
          "$ref": "#/$defs/Identity"
        },
        "kind": {
          "type": "string",
          "const": "family"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "format_version",
        "identity",
        "geometry",
        "aerodynamics",
        "controls"
      ]
    },
    {
      "type": "object",
      "properties": {
        "cg_envelope": {
          "description": "Polygon vertices [longitudinal CG in metres, total mass in kg], ordered around its edge.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            },
            "maxItems": 2,
            "minItems": 2
          },
          "maxItems": 64,
          "minItems": 3
        },
        "empty_mass": {
          "$ref": "#/$defs/Mass"
        },
        "engine": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "flap_stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FlapStage"
          },
          "maxItems": 32,
          "minItems": 2
        },
        "format_version": {
          "type": "integer",
          "format": "uint32",
          "maximum": 2,
          "minimum": 2
        },
        "fuel_capacity_kg": {
          "type": "number",
          "format": "double"
        },
        "identity": {
          "$ref": "#/$defs/Identity"
        },
        "kind": {
          "type": "string",
          "const": "variant"
        },
        "max_mass_kg": {
          "type": "number",
          "format": "double"
        },
        "min_mass_kg": {
          "type": "number",
          "format": "double"
        },
        "stations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LoadStation"
          },
          "maxItems": 64
        },
        "systems": {
          "type": "string"
        },
        "v_speeds": {
          "$ref": "#/$defs/VSpeeds"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "format_version",
        "identity",
        "family",
        "engine",
        "systems",
        "empty_mass",
        "min_mass_kg",
        "max_mass_kg",
        "cg_envelope",
        "flap_stages",
        "fuel_capacity_kg",
        "stations",
        "v_speeds"
      ]
    },
    {
      "type": "object",
      "properties": {
        "format_version": {
          "type": "integer",
          "format": "uint32",
          "maximum": 2,
          "minimum": 2
        },
        "fuel_flow_kg_s": {
          "description": "Fuel flow against normalised shaft power, kg/s. Metadata until fuel burn is implemented.",
          "$ref": "#/$defs/Table"
        },
        "identity": {
          "$ref": "#/$defs/Identity"
        },
        "induction": {
          "$ref": "#/$defs/Induction"
        },
        "kind": {
          "type": "string",
          "const": "engine"
        },
        "propulsion": {
          "description": "Shaft power versus density ratio and fixed-pitch propeller CT/CP versus advance ratio.",
          "$ref": "#/$defs/Propulsion"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "format_version",
        "identity",
        "propulsion",
        "induction",
        "fuel_flow_kg_s"
      ]
    },
    {
      "type": "object",
      "properties": {
        "definition": {
          "description": "Absent for legacy placeholder installations.",
          "anyOf": [
            {
              "$ref": "#/$defs/SystemsDefinition"
            },
            {
              "type": "null"
            }
          ]
        },
        "format_version": {
          "type": "integer",
          "format": "uint32",
          "maximum": 2,
          "minimum": 2
        },
        "identity": {
          "$ref": "#/$defs/Identity"
        },
        "installed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 64
        },
        "kind": {
          "type": "string",
          "const": "systems"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "format_version",
        "identity",
        "installed"
      ]
    },
    {
      "type": "object",
      "properties": {
        "autopilot": {
          "anyOf": [
            {
              "$ref": "#/$defs/AutopilotInstallation"
            },
            {
              "type": "null"
            }
          ]
        },
        "format_version": {
          "type": "integer",
          "format": "uint32",
          "maximum": 2,
          "minimum": 2
        },
        "identity": {
          "$ref": "#/$defs/Identity"
        },
        "instruments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InstrumentInstallation"
          },
          "maxItems": 64,
          "minItems": 1
        },
        "kind": {
          "type": "string",
          "const": "panel"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "format_version",
        "identity",
        "instruments"
      ]
    },
    {
      "type": "object",
      "properties": {
        "format_version": {
          "type": "integer",
          "format": "uint32",
          "maximum": 2,
          "minimum": 2
        },
        "identity": {
          "$ref": "#/$defs/Identity"
        },
        "kind": {
          "type": "string",
          "const": "aircraft"
        },
        "load": {
          "$ref": "#/$defs/Load"
        },
        "panel": {
          "type": "string"
        },
        "variant": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "format_version",
        "identity",
        "variant",
        "panel",
        "load"
      ]
    }
  ],
  "$defs": {
    "Aerodynamics": {
      "type": "object",
      "properties": {
        "blend_start_rad": {
          "type": "number",
          "format": "double"
        },
        "blend_width_rad": {
          "type": "number",
          "format": "double"
        },
        "cd_alpha": {
          "$ref": "#/$defs/Table"
        },
        "cl_beta": {
          "$ref": "#/$defs/Table"
        },
        "cl_clean": {
          "$ref": "#/$defs/Table"
        },
        "cl_flaps": {
          "$ref": "#/$defs/Table"
        },
        "cl_max": {
          "type": "number",
          "format": "double"
        },
        "cm_alpha": {
          "$ref": "#/$defs/Table"
        },
        "cn_beta": {
          "$ref": "#/$defs/Table"
        },
        "cy_beta": {
          "$ref": "#/$defs/Table"
        },
        "derivatives": {
          "$ref": "#/$defs/Derivatives"
        },
        "derivatives_source": {
          "type": "string"
        },
        "flap_drag": {
          "type": "number",
          "format": "double"
        },
        "flap_pitch": {
          "type": "number",
          "format": "double"
        },
        "induced_drag": {
          "type": "number",
          "format": "double"
        },
        "plate_drag": {
          "type": "number",
          "format": "double"
        },
        "plate_drag_zero": {
          "type": "number",
          "format": "double"
        },
        "plate_pitch": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "cl_clean",
        "cl_flaps",
        "cd_alpha",
        "cm_alpha",
        "cy_beta",
        "cl_beta",
        "cn_beta",
        "derivatives",
        "derivatives_source",
        "cl_max",
        "induced_drag",
        "flap_drag",
        "flap_pitch",
        "blend_start_rad",
        "blend_width_rad",
        "plate_drag_zero",
        "plate_drag",
        "plate_pitch"
      ]
    },
    "AirframeControls": {
      "description": "Surface travel and ground contact properties belong to the airframe; detents to the variant.",
      "type": "object",
      "properties": {
        "aileron": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "brake": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "brake_friction": {
          "type": "number",
          "format": "double"
        },
        "elevator": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "flaps": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "gear_travel_m": {
          "type": "number",
          "format": "double"
        },
        "hard_touchdown_mps": {
          "type": "number",
          "format": "double"
        },
        "lateral_friction": {
          "type": "number",
          "format": "double"
        },
        "max_normal_force_n": {
          "type": "number",
          "format": "double"
        },
        "rolling_other": {
          "type": "number",
          "format": "double"
        },
        "rolling_pavement": {
          "type": "number",
          "format": "double"
        },
        "rudder": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "throttle": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        }
      },
      "additionalProperties": false,
      "required": [
        "elevator",
        "aileron",
        "rudder",
        "throttle",
        "flaps",
        "brake",
        "gear_travel_m",
        "max_normal_force_n",
        "hard_touchdown_mps",
        "rolling_pavement",
        "rolling_other",
        "brake_friction",
        "lateral_friction"
      ]
    },
    "AutopilotFamily": {
      "type": "string",
      "enum": [
        "wing_leveler",
        "two_axis_legacy",
        "digital_two_axis"
      ]
    },
    "AutopilotInstallation": {
      "description": "Normalised control force is used for servo torque: 1 is full pilot authority.",
      "type": "object",
      "properties": {
        "altitude_alert": {
          "type": "boolean"
        },
        "altitude_preselect": {
          "type": "boolean"
        },
        "bank_limit_rad": {
          "type": "number",
          "format": "double"
        },
        "electric_trim": {
          "type": "boolean"
        },
        "family": {
          "$ref": "#/$defs/AutopilotFamily"
        },
        "lateral_modes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LateralMode"
          }
        },
        "max_load_g": {
          "type": "number",
          "format": "double"
        },
        "maximum_ias_mps": {
          "type": "number",
          "format": "double"
        },
        "minimum_ias_mps": {
          "type": "number",
          "format": "double"
        },
        "pitch_rate_limit_rps": {
          "type": "number",
          "format": "double"
        },
        "power_load": {
          "type": "string"
        },
        "roll_sensor_load": {
          "type": "string"
        },
        "servo_rate_per_s": {
          "type": "number",
          "format": "double"
        },
        "servo_torque": {
          "type": "number",
          "format": "double"
        },
        "stability_protection": {
          "type": "boolean"
        },
        "vertical_modes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VerticalMode"
          }
        },
        "yaw_damper": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "family",
        "lateral_modes",
        "vertical_modes",
        "power_load",
        "roll_sensor_load",
        "bank_limit_rad",
        "pitch_rate_limit_rps",
        "max_load_g",
        "servo_torque",
        "servo_rate_per_s",
        "electric_trim",
        "altitude_preselect",
        "altitude_alert",
        "stability_protection",
        "yaw_damper",
        "minimum_ias_mps",
        "maximum_ias_mps"
      ]
    },
    "Bus": {
      "type": "string",
      "enum": [
        "main",
        "essential"
      ]
    },
    "Derivatives": {
      "type": "object",
      "properties": {
        "cl_aileron": {
          "type": "number",
          "format": "double"
        },
        "cl_p": {
          "type": "number",
          "format": "double"
        },
        "cl_r": {
          "type": "number",
          "format": "double"
        },
        "cm_elevator": {
          "type": "number",
          "format": "double"
        },
        "cm_q": {
          "type": "number",
          "format": "double"
        },
        "cn_aileron": {
          "type": "number",
          "format": "double"
        },
        "cn_p": {
          "type": "number",
          "format": "double"
        },
        "cn_r": {
          "type": "number",
          "format": "double"
        },
        "cn_rudder": {
          "type": "number",
          "format": "double"
        },
        "cy_r": {
          "type": "number",
          "format": "double"
        },
        "cy_rudder": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "cl_p",
        "cl_r",
        "cm_q",
        "cn_p",
        "cn_r",
        "cy_r",
        "cl_aileron",
        "cm_elevator",
        "cn_rudder",
        "cy_rudder",
        "cn_aileron"
      ]
    },
    "ElectricalDefinition": {
      "type": "object",
      "properties": {
        "alternator_amps": {
          "$ref": "#/$defs/Table"
        },
        "alternator_voltage": {
          "type": "number",
          "format": "double"
        },
        "battery_capacity_ah": {
          "type": "number",
          "format": "double"
        },
        "battery_voltage": {
          "type": "number",
          "format": "double"
        },
        "loads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ElectricalLoad"
          },
          "maxItems": 64,
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "battery_capacity_ah",
        "battery_voltage",
        "alternator_voltage",
        "alternator_amps",
        "loads"
      ]
    },
    "ElectricalLoad": {
      "type": "object",
      "properties": {
        "amps": {
          "type": "number",
          "format": "double"
        },
        "backup_capacity_ah": {
          "description": "Zero for equipment without an internal battery.",
          "type": "number",
          "format": "double"
        },
        "breaker_amps": {
          "type": "number",
          "format": "double"
        },
        "bus": {
          "$ref": "#/$defs/Bus"
        },
        "id": {
          "type": "string"
        },
        "switch": {
          "$ref": "#/$defs/LoadSwitch"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "bus",
        "switch",
        "amps",
        "breaker_amps",
        "backup_capacity_ah"
      ]
    },
    "EngineOperationDefinition": {
      "type": "object",
      "properties": {
        "carb_heat_clear_rate": {
          "type": "number",
          "format": "double"
        },
        "carb_heat_power_fraction": {
          "type": "number",
          "format": "double"
        },
        "carb_ice_humidity": {
          "description": "Multiplier against relative humidity, 0..1.",
          "$ref": "#/$defs/Table"
        },
        "carb_ice_rate": {
          "description": "Icing accumulation per second against ambient temperature (degrees Celsius).",
          "$ref": "#/$defs/Table"
        },
        "cht_lag_s": {
          "type": "number",
          "format": "double"
        },
        "egt_lag_s": {
          "type": "number",
          "format": "double"
        },
        "single_mag_power_fraction": {
          "type": "number",
          "format": "double"
        },
        "start_time_s": {
          "type": "number",
          "format": "double"
        },
        "starter_amps": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "single_mag_power_fraction",
        "carb_heat_power_fraction",
        "carb_ice_rate",
        "carb_ice_humidity",
        "carb_heat_clear_rate",
        "egt_lag_s",
        "cht_lag_s",
        "start_time_s",
        "starter_amps"
      ]
    },
    "FlapStage": {
      "type": "object",
      "properties": {
        "max_speed_mps": {
          "type": "number",
          "format": "double"
        },
        "position": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "position",
        "max_speed_mps"
      ]
    },
    "Gear": {
      "type": "object",
      "properties": {
        "damping_ns_m": {
          "type": "number",
          "format": "double"
        },
        "point_m": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "steering_rad": {
          "type": "number",
          "format": "double"
        },
        "stiffness_n_m": {
          "type": "number",
          "format": "double"
        },
        "weight_fraction": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "point_m",
        "stiffness_n_m",
        "damping_ns_m",
        "weight_fraction",
        "steering_rad"
      ]
    },
    "Geometry": {
      "type": "object",
      "properties": {
        "chord_m": {
          "type": "number",
          "format": "double"
        },
        "gear": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Gear"
          },
          "maxItems": 16,
          "minItems": 1
        },
        "hard_points_m": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            },
            "maxItems": 3,
            "minItems": 3
          },
          "maxItems": 64,
          "minItems": 1
        },
        "reference_point_m": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "span_m": {
          "type": "number",
          "format": "double"
        },
        "wing_area_m2": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "wing_area_m2",
        "span_m",
        "chord_m",
        "reference_point_m",
        "gear",
        "hard_points_m"
      ]
    },
    "Identity": {
      "type": "object",
      "properties": {
        "author": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "description",
        "author"
      ]
    },
    "Induction": {
      "type": "string",
      "enum": [
        "carburettor",
        "injection"
      ]
    },
    "InstrumentInstallation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "position": {
          "description": "Panel grid position and size, in arbitrary panel units.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "size": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "skin": {
          "description": "Runtime skin registry id. Omitted declarations use the original public skin.",
          "type": "string",
          "default": "original"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "module",
        "position",
        "size"
      ]
    },
    "LateralMode": {
      "type": "string",
      "enum": [
        "rol",
        "hdg",
        "trk",
        "nav",
        "apr",
        "rev",
        "loc_bc"
      ]
    },
    "Load": {
      "type": "object",
      "properties": {
        "stations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StationLoad"
          },
          "maxItems": 64
        }
      },
      "additionalProperties": false,
      "required": [
        "stations"
      ]
    },
    "LoadStation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/StationKind"
        },
        "max_mass_kg": {
          "type": "number",
          "format": "double"
        },
        "position_m": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 3,
          "minItems": 3
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "position_m",
        "max_mass_kg"
      ]
    },
    "LoadSwitch": {
      "type": "string",
      "enum": [
        "avionics",
        "lights",
        "fuel_pump",
        "pitot_heat",
        "always"
      ]
    },
    "Mass": {
      "type": "object",
      "properties": {
        "cg_m": {
          "type": "array",
          "items": {
