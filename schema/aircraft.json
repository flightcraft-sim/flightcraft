{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LayerFile",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "aerodynamics": {
          "$ref": "#/$defs/Aerodynamics"
        },
        "controls": {
          "$ref": "#/$defs/AirframeControls"
        },
        "format_version": {
          "type": "integer",
          "format": "uint32",
          "maximum": 2,
          "minimum": 2
        },
        "geometry": {
          "$ref": "#/$defs/Geometry"
        },
        "identity": {
          "$ref": "#/$defs/Identity"
        },
        "kind": {
          "type": "string",
          "const": "family"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "format_version",
        "identity",
        "geometry",
        "aerodynamics",
        "controls"
      ]
    },
    {
      "type": "object",
      "properties": {
        "cg_envelope": {
          "description": "Polygon vertices [longitudinal CG in metres, total mass in kg], ordered around its edge.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            },
            "maxItems": 2,
            "minItems": 2
          },
          "maxItems": 64,
          "minItems": 3
        },
        "empty_mass": {
          "$ref": "#/$defs/Mass"
        },
        "engine": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "flap_stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FlapStage"
          },
          "maxItems": 32,
          "minItems": 2
        },
        "format_version": {
          "type": "integer",
          "format": "uint32",
          "maximum": 2,
          "minimum": 2
        },
        "fuel_capacity_kg": {
          "type": "number",
          "format": "double"
        },
        "identity": {
          "$ref": "#/$defs/Identity"
        },
        "kind": {
          "type": "string",
          "const": "variant"
        },
        "max_mass_kg": {
          "type": "number",
          "format": "double"
        },
        "min_mass_kg": {
          "type": "number",
          "format": "double"
        },
        "stations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LoadStation"
          },
          "maxItems": 64
        },
        "systems": {
          "type": "string"
        },
        "v_speeds": {
          "$ref": "#/$defs/VSpeeds"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "format_version",
        "identity",
        "family",
        "engine",
        "systems",
        "empty_mass",
        "min_mass_kg",
        "max_mass_kg",
        "cg_envelope",
        "flap_stages",
        "fuel_capacity_kg",
        "stations",
        "v_speeds"
      ]
    },
    {
      "type": "object",
      "properties": {
        "format_version": {
          "type": "integer",
          "format": "uint32",
          "maximum": 2,
          "minimum": 2
        },
        "fuel_flow_kg_s": {
          "description": "Fuel flow against normalised shaft power, kg/s. Metadata until fuel burn is implemented.",
          "$ref": "#/$defs/Table"
        },
        "identity": {
          "$ref": "#/$defs/Identity"
        },
        "induction": {
          "$ref": "#/$defs/Induction"
        },
        "kind": {
          "type": "string",
          "const": "engine"
        },
        "propulsion": {
          "description": "Shaft power versus density ratio and fixed-pitch propeller CT/CP versus advance ratio.",
          "$ref": "#/$defs/Propulsion"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "format_version",
        "identity",
        "propulsion",
        "induction",
        "fuel_flow_kg_s"
      ]
    },
    {
      "type": "object",
      "properties": {
        "format_version": {
          "type": "integer",
          "format": "uint32",
          "maximum": 2,
          "minimum": 2
        },
        "identity": {
          "$ref": "#/$defs/Identity"
        },
        "installed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 64
        },
        "kind": {
          "type": "string",
          "const": "systems"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "format_version",
        "identity",
        "installed"
      ]
    },
    {
      "type": "object",
      "properties": {
        "format_version": {
          "type": "integer",
          "format": "uint32",
          "maximum": 2,
          "minimum": 2
        },
        "identity": {
          "$ref": "#/$defs/Identity"
        },
        "instruments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InstrumentInstallation"
          },
          "maxItems": 64,
          "minItems": 1
        },
        "kind": {
          "type": "string",
          "const": "panel"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "format_version",
        "identity",
        "instruments"
      ]
    },
    {
      "type": "object",
      "properties": {
        "format_version": {
          "type": "integer",
          "format": "uint32",
          "maximum": 2,
          "minimum": 2
        },
        "identity": {
          "$ref": "#/$defs/Identity"
        },
        "kind": {
          "type": "string",
          "const": "aircraft"
        },
        "load": {
          "$ref": "#/$defs/Load"
        },
        "panel": {
          "type": "string"
        },
        "variant": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "format_version",
        "identity",
        "variant",
        "panel",
        "load"
      ]
    }
  ],
  "$defs": {
    "Aerodynamics": {
      "type": "object",
      "properties": {
        "blend_start_rad": {
          "type": "number",
          "format": "double"
        },
        "blend_width_rad": {
          "type": "number",
          "format": "double"
        },
        "cd_alpha": {
          "$ref": "#/$defs/Table"
        },
        "cl_beta": {
          "$ref": "#/$defs/Table"
        },
        "cl_clean": {
          "$ref": "#/$defs/Table"
        },
        "cl_flaps": {
          "$ref": "#/$defs/Table"
        },
        "cl_max": {
          "type": "number",
          "format": "double"
        },
        "cm_alpha": {
          "$ref": "#/$defs/Table"
        },
        "cn_beta": {
          "$ref": "#/$defs/Table"
        },
        "cy_beta": {
          "$ref": "#/$defs/Table"
        },
        "derivatives": {
          "$ref": "#/$defs/Derivatives"
        },
        "derivatives_source": {
          "type": "string"
        },
        "flap_drag": {
          "type": "number",
          "format": "double"
        },
        "flap_pitch": {
          "type": "number",
          "format": "double"
        },
        "induced_drag": {
          "type": "number",
          "format": "double"
        },
        "plate_drag": {
          "type": "number",
          "format": "double"
        },
        "plate_drag_zero": {
          "type": "number",
          "format": "double"
        },
        "plate_pitch": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "cl_clean",
        "cl_flaps",
        "cd_alpha",
        "cm_alpha",
        "cy_beta",
        "cl_beta",
        "cn_beta",
        "derivatives",
        "derivatives_source",
        "cl_max",
        "induced_drag",
        "flap_drag",
        "flap_pitch",
        "blend_start_rad",
        "blend_width_rad",
        "plate_drag_zero",
        "plate_drag",
        "plate_pitch"
      ]
    },
    "AirframeControls": {
      "description": "Surface travel and ground contact properties belong to the airframe; detents to the variant.",
      "type": "object",
      "properties": {
        "aileron": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "brake": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "brake_friction": {
          "type": "number",
          "format": "double"
        },
        "elevator": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "flaps": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "gear_travel_m": {
          "type": "number",
          "format": "double"
        },
        "hard_touchdown_mps": {
          "type": "number",
          "format": "double"
        },
        "lateral_friction": {
          "type": "number",
          "format": "double"
        },
        "max_normal_force_n": {
          "type": "number",
          "format": "double"
        },
        "rolling_other": {
          "type": "number",
          "format": "double"
        },
        "rolling_pavement": {
          "type": "number",
          "format": "double"
        },
        "rudder": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "throttle": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        }
      },
      "additionalProperties": false,
      "required": [
        "elevator",
        "aileron",
        "rudder",
        "throttle",
        "flaps",
        "brake",
        "gear_travel_m",
        "max_normal_force_n",
        "hard_touchdown_mps",
        "rolling_pavement",
        "rolling_other",
        "brake_friction",
        "lateral_friction"
      ]
    },
    "Derivatives": {
      "type": "object",
      "properties": {
        "cl_aileron": {
          "type": "number",
          "format": "double"
        },
        "cl_p": {
          "type": "number",
          "format": "double"
        },
        "cl_r": {
          "type": "number",
          "format": "double"
        },
        "cm_elevator": {
          "type": "number",
          "format": "double"
        },
        "cm_q": {
          "type": "number",
          "format": "double"
        },
        "cn_aileron": {
          "type": "number",
          "format": "double"
        },
        "cn_p": {
          "type": "number",
          "format": "double"
        },
        "cn_r": {
          "type": "number",
          "format": "double"
        },
        "cn_rudder": {
          "type": "number",
          "format": "double"
        },
        "cy_r": {
          "type": "number",
          "format": "double"
        },
        "cy_rudder": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "cl_p",
        "cl_r",
        "cm_q",
        "cn_p",
        "cn_r",
        "cy_r",
        "cl_aileron",
        "cm_elevator",
        "cn_rudder",
        "cy_rudder",
        "cn_aileron"
      ]
    },
    "FlapStage": {
      "type": "object",
      "properties": {
        "max_speed_mps": {
          "type": "number",
          "format": "double"
        },
        "position": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "position",
        "max_speed_mps"
      ]
    },
    "Gear": {
      "type": "object",
      "properties": {
        "damping_ns_m": {
          "type": "number",
          "format": "double"
        },
        "point_m": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "steering_rad": {
          "type": "number",
          "format": "double"
        },
        "stiffness_n_m": {
          "type": "number",
          "format": "double"
        },
        "weight_fraction": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "point_m",
        "stiffness_n_m",
        "damping_ns_m",
        "weight_fraction",
        "steering_rad"
      ]
    },
    "Geometry": {
      "type": "object",
      "properties": {
        "chord_m": {
          "type": "number",
          "format": "double"
        },
        "gear": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Gear"
          },
          "maxItems": 16,
          "minItems": 1
        },
        "hard_points_m": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            },
            "maxItems": 3,
            "minItems": 3
          },
          "maxItems": 64,
          "minItems": 1
        },
        "reference_point_m": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "span_m": {
          "type": "number",
          "format": "double"
        },
        "wing_area_m2": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "wing_area_m2",
        "span_m",
        "chord_m",
        "reference_point_m",
        "gear",
        "hard_points_m"
      ]
    },
    "Identity": {
      "type": "object",
      "properties": {
        "author": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "description",
        "author"
      ]
    },
    "Induction": {
      "type": "string",
      "enum": [
        "carburettor",
        "injection"
      ]
    },
    "InstrumentInstallation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "position": {
          "description": "Panel grid position and size, in arbitrary panel units.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "size": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "module",
        "position",
        "size"
      ]
    },
    "Load": {
      "type": "object",
      "properties": {
        "stations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StationLoad"
          },
          "maxItems": 64
        }
      },
      "additionalProperties": false,
      "required": [
        "stations"
      ]
    },
    "LoadStation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/StationKind"
        },
        "max_mass_kg": {
          "type": "number",
          "format": "double"
        },
        "position_m": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 3,
          "minItems": 3
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "position_m",
        "max_mass_kg"
      ]
    },
    "Mass": {
      "type": "object",
      "properties": {
        "cg_m": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "inertia_kg_m2": {
          "description": "Full symmetric positive-definite tensor about the CG, in body axes.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            },
            "maxItems": 3,
            "minItems": 3
          },
          "maxItems": 3,
          "minItems": 3
        },
        "mass_kg": {
          "description": "Resolved total flight mass, including occupants and fuel.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "mass_kg",
        "cg_m",
        "inertia_kg_m2"
      ]
    },
    "Propulsion": {
      "type": "object",
      "properties": {
        "idle_power_w": {
          "type": "number",
          "format": "double"
        },
        "max_power_w": {
          "type": "number",
          "format": "double"
        },
        "max_rpm": {
          "type": "number",
          "format": "double"
        },
        "min_rps": {
          "type": "number",
          "format": "double"
        },
        "power_density": {
          "$ref": "#/$defs/Table"
        },
        "prop_cp": {
          "$ref": "#/$defs/Table"
        },
        "prop_ct": {
          "$ref": "#/$defs/Table"
        },
        "prop_diameter_m": {
          "type": "number",
          "format": "double"
        },
        "windmill_advance_ratio": {
          "type": "number",
          "format": "double"
        },
        "windmill_drag_area_m2": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "max_power_w",
        "idle_power_w",
        "prop_diameter_m",
        "min_rps",
        "max_rpm",
        "windmill_drag_area_m2",
        "windmill_advance_ratio",
        "prop_ct",
        "prop_cp",
        "power_density"
      ]
    },
    "StationKind": {
      "type": "string",
      "enum": [
        "pilot",
        "passenger",
        "baggage",
        "fuel"
      ]
    },
    "StationLoad": {
      "type": "object",
      "properties": {
        "mass_kg": {
          "type": "number",
          "format": "double"
        },
        "station": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "station",
        "mass_kg"
      ]
    },
    "Table": {
      "type": "object",
      "properties": {
        "points": {
          "description": "[breakpoint, ordinate], linear interpolation, clamped at the edges.",
          "type": "array",
          "items": {
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number",
                "format": "double"
              },
              {
                "type": "number",
                "format": "double"
              }
            ]
          },
          "maxItems": 256,
          "minItems": 2
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "points",
        "source"
      ]
    },
    "VSpeeds": {
      "type": "object",
      "properties": {
        "vfe_mps": {
          "type": "number",
          "format": "double"
        },
        "vne_mps": {
          "type": "number",
          "format": "double"
        },
        "vno_mps": {
          "type": "number",
          "format": "double"
        },
        "vr_mps": {
          "type": "number",
          "format": "double"
        },
        "vs_mps": {
          "type": "number",
          "format": "double"
        },
        "vso_mps": {
          "type": "number",
          "format": "double"
        },
        "vx_mps": {
          "type": "number",
          "format": "double"
        },
        "vy_mps": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "vs_mps",
        "vso_mps",
        "vr_mps",
        "vx_mps",
        "vy_mps",
        "vfe_mps",
        "vno_mps",
        "vne_mps"
      ]
    }
  }
}
